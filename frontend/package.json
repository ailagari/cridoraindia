{
  "name": "cridoraindia-v2-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-sitemap.mjs && tsc -b && vite build",
    "build:capacitor": "node scripts/check-android-env.mjs && tsc -b && vite build --mode capacitor",
    "build:android": "node scripts/check-android-env.mjs && npm run build:capacitor && npm run android:icons && npx cap sync android",
    "android:rebuild": "npm run build:android && cd android && .\\gradlew.bat assembleDebug",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "android:apk": "npm run build:android && cd android && .\\gradlew.bat assembleRelease",
    "android:apk:debug": "npm run build:android && cd android && .\\gradlew.bat assembleDebug",
    "rasterize-icons": "node scripts/rasterize-logo.mjs",
    "android:icons": "node scripts/generate-android-icons.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^7.5.0",
    "@capacitor/android": "^7.2.0",
    "@capacitor/app": "^7.0.1",
    "@capacitor/core": "^7.2.0",
    "@capacitor/local-notifications": "^7.0.1",
    "@capacitor/push-notifications": "^7.0.1",
    "html5-qrcode": "^2.3.8",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.34.5",
    "typescript": "~5.6.3",
    "vite": "^6.0.1",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-precaching": "^7.4.1"
  }
}
