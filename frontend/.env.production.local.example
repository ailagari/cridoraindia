# Copy to .env.production.local before building the Android APK.
# Vite bakes this into the bundle at build time (web + Android via .env.capacitor.local).
#
# Production (Railway — use your actual service URL):
VITE_API_BASE_URL=https://cridoraindia-production.up.railway.app

# Android/Capacitor local builds only — do NOT set on Railway web service (breaks dashboard refresh).
# VITE_CAPACITOR_BUILD=true
# Optional: in .env.capacitor set VITE_CAPACITOR_LIVE_WEBVIEW=true to load production UI in WebView (not bundled dist).
# FCM: on by default in the Android app when google-services.json is present. Set false only for builds without Firebase.
# VITE_FCM_ENABLED=false
#
# Optional — Google AdSense publisher ID (must match backend ADSENSE_PUBLISHER_ID)
# VITE_ADSENSE_PUBLISHER_ID=ca-pub-1180208702657280
#
# VITE_GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
#
# GA4 is injected server-side (backend default: G-4KGJCVPZV6). Optional Railway override:
# GA4_MEASUREMENT_ID=G-4KGJCVPZV6
#
# VITE_API_BASE_URL=https://cridora.in
# Railway direct URL (if different from custom domain):
# VITE_API_BASE_URL=https://your-service.up.railway.app
#
# Local backend on your PC (phone must be on same Wi‑Fi; use debug APK):
# VITE_API_BASE_URL=http://192.168.1.100:8000
